[{"id":"miss","chip":"爸，我好想你","keys":["想你","好想你","很想你","思念","想念你","想爸爸","想阿公","想爺爺"],"caps":[{"s":0.0,"e":2.46,"t":"傻孩子，我都知道。"},{"s":2.71,"e":10.69,"t":"想我的時候，就抬頭看看天邊的晚霞，我一直都在，從來沒有走遠。"}]},{"id":"there","chip":"你在那邊好嗎？","keys":["那邊好嗎","過得好嗎","在那裡好嗎","你好嗎","還好嗎","會冷嗎","會孤單嗎","天上"],"caps":[{"s":0.0,"e":3.67,"t":"我在這裡很好，不痛了，也不累了。"},{"s":3.92,"e":7.65,"t":"每天都能看夕陽，心裡很平靜。"},{"s":7.9,"e":10.21,"t":"你們不用替我擔心。"}]},{"id":"sorry","chip":"對不起，沒有好好陪你","keys":["對不起","抱歉","沒陪你","沒有陪","不孝","後悔","來不及","沒見到最後一面","最後一面"],"caps":[{"s":0.0,"e":3.96,"t":"孩子，不要跟爸爸說對不起。"},{"s":4.21,"e":7.41,"t":"你們每一個都是我的驕傲。"},{"s":7.66,"e":13.68,"t":"那些來不及的事，就放下吧，我從來沒有怪過你。"}]},{"id":"mom","chip":"媽媽怎麼辦？","keys":["媽媽","老伴","奶奶","阿嬤","外婆","太太","妻子","照顧媽"],"caps":[{"s":0.0,"e":2.94,"t":"你們的媽媽，就拜託你們了。"},{"s":3.19,"e":7.07,"t":"她嘴上不說，心裡最怕孤單。"},{"s":7.32,"e":14.32,"t":"常常回家陪她吃頓飯，聽她說說話，就是對我最好的孝順。"}]},{"id":"wife","chip":"老伴，我好想你","keys":["老公","老伴想你","我是你太太","我是你老婆","我們結婚","你的妻子"],"caps":[{"s":0.0,"e":5.3,"t":"老伴，這輩子娶到你，是我最大的福氣。"},{"s":5.55,"e":10.19,"t":"我先走一步，你要好好吃飯，好好睡覺。"},{"s":10.44,"e":14.65,"t":"不要急，慢慢過，我會在這裡等你。"}]},{"id":"grandchild","chip":"爺爺，我是小孫女","keys":["孫女","孫子","我是你孫","小孫","乖孫","我是孫"],"caps":[{"s":0.0,"e":6.32,"t":"乖孫，爺爺最喜歡跟你坐在公園的長椅上翻相簿了。"},{"s":6.57,"e":11.22,"t":"那些照片裡的故事，現在都交給你囉。"},{"s":11.47,"e":13.91,"t":"要開開心心長大。"}]},{"id":"story","chip":"想聽你說以前的故事","keys":["故事","以前","年輕的時候","當年","小時候","說說","回憶","過去"],"caps":[{"s":0.0,"e":9.06,"t":"年輕的時候，我總是夾著一本筆記在校園裡跑來跑去，見了誰都要打聲招呼。"},{"s":9.31,"e":18.11,"t":"後來遇見你們的媽媽，那天我鼓起勇氣牽了她的手，這一牽，就是一輩子。"}]},{"id":"advice","chip":"你有什麼話想交代？","keys":["交代","叮嚀","囑咐","要我們做什麼","最後的話","想說什麼","還有什麼話","遺言"],"caps":[{"s":0.0,"e":1.78,"t":"沒什麼大道理。"},{"s":2.03,"e":6.83,"t":"一家人要和和氣氣的，有話好好說。"},{"s":7.08,"e":11.96,"t":"身體顧好，飯要按時吃，有空多回家。"},{"s":12.21,"e":14.48,"t":"這樣我就放心了。"}]},{"id":"married","chip":"我要結婚了","keys":["結婚","婚禮","訂婚","嫁","娶","另一半","男朋友","女朋友","對象"],"caps":[{"s":0.0,"e":1.05,"t":"真的嗎？"},{"s":1.3,"e":2.58,"t":"太好了！"},{"s":2.83,"e":4.57,"t":"爸爸替你高興。"},{"s":4.82,"e":10.48,"t":"記得，兩個人過日子，要互相體諒，吵架不要隔夜。"},{"s":10.73,"e":14.74,"t":"婚禮那天，我會在旁邊看著你的。"}]},{"id":"baby","chip":"我們家有新寶寶了","keys":["寶寶","懷孕","生小孩","出生","當爸爸","當媽媽","生了","小baby","曾孫"],"caps":[{"s":0.0,"e":3.68,"t":"家裡又多了一個小生命，真好。"},{"s":3.93,"e":8.29,"t":"好好抱抱他，替我親一下他的小臉。"},{"s":8.54,"e":12.54,"t":"告訴他，有一個爺爺，很愛很愛他。"}]},{"id":"exam","chip":"我考上了／畢業了","keys":["考上","畢業","錄取","升學","考試","成績","學校","大學"],"caps":[{"s":0.0,"e":2.08,"t":"我就知道你可以！"},{"s":2.33,"e":3.78,"t":"爸爸好驕傲。"},{"s":4.03,"e":11.81,"t":"不管走到哪裡，都要記得，認真讀書，也要熱心幫助身邊的人。"}]},{"id":"job","chip":"我換工作／升職了","keys":["工作","升職","升官","加薪","換工作","新工作","上班","老闆","公司"],"caps":[{"s":0.0,"e":2.06,"t":"好啊，辛苦你了。"},{"s":2.31,"e":6.5,"t":"工作要認真，但別把自己累壞了。"},{"s":6.75,"e":12.54,"t":"記得，晚飯盡量回家吃，家人永遠比工作重要。"}]},{"id":"tired","chip":"最近好累、好難過","keys":["累","難過","傷心","心情不好","壓力","撐不下去","好苦","沮喪","想哭","憂鬱"],"caps":[{"s":0.0,"e":5.64,"t":"孩子，累了就歇一歇，想哭就哭吧，不丟臉。"},{"s":5.89,"e":10.09,"t":"日子再難，也會一天一天過去。"},{"s":10.34,"e":14.51,"t":"爸爸一直在你身後，你不是一個人。"}]},{"id":"health","chip":"我們會照顧好身體","keys":["身體","健康","生病","醫院","看醫生","保重","照顧自己"],"caps":[{"s":0.0,"e":1.69,"t":"這樣最好。"},{"s":1.94,"e":5.78,"t":"身體是自己的，也是家人的。"},{"s":6.03,"e":13.03,"t":"少熬夜，多走走，有不舒服就去看醫生，別像我以前那麼固執。"}]},{"id":"pain","chip":"你最後痛不痛？","keys":["痛不痛","痛嗎","辛苦嗎","受苦","病痛","最後的時候","走的時候","怕不怕"],"caps":[{"s":0.0,"e":1.82,"t":"不痛了，真的。"},{"s":2.07,"e":8.29,"t":"最後那段日子，有你們陪在身邊，我心裡很踏實。"},{"s":8.54,"e":12.71,"t":"走的時候很安詳，你們不要再難過了。"}]},{"id":"love","chip":"我愛你","keys":["愛你","我愛你","喜歡你","最愛"],"caps":[{"s":0.0,"e":2.4,"t":"我也愛你，孩子。"},{"s":2.65,"e":6.92,"t":"以前嘴笨，這句話說得太少了。"},{"s":7.17,"e":13.25,"t":"今天多說幾次：我愛你，我愛你們，永遠都愛。"}],"bow":true},{"id":"thanks","chip":"謝謝你","keys":["謝謝","感謝","感恩","多謝"],"caps":[{"s":0.0,"e":2.38,"t":"該說謝謝的是我。"},{"s":2.63,"e":6.17,"t":"謝謝你們，陪我走完這一生。"},{"s":6.42,"e":9.57,"t":"有你們，這輩子值得了。"}],"bow":true},{"id":"proud","chip":"你會為我驕傲嗎？","keys":["驕傲","失望","做得好嗎","滿意","夠好嗎","合格","表現"],"caps":[{"s":0.0,"e":1.22,"t":"當然會。"},{"s":1.47,"e":8.82,"t":"你不用做到多了不起，只要做個善良、踏實的人，爸爸就為你驕傲。"},{"s":9.07,"e":11.26,"t":"你已經做得很好了。"}]},{"id":"dream","chip":"我夢到你了","keys":["夢","夢見","夢到","托夢"],"caps":[{"s":0.0,"e":0.87,"t":"是嗎？"},{"s":1.12,"e":5.76,"t":"那一定是我太想你了，偷偷回去看看你。"},{"s":6.01,"e":11.34,"t":"夢裡見到了，醒來就要笑一笑，好好過今天。"}]},{"id":"sunset","chip":"你為什麼喜歡看夕陽？","keys":["夕陽","湖邊","晚霞","黃昏","看海","風景"],"caps":[{"s":0.0,"e":5.43,"t":"因為夕陽會告訴你，每一天都值得好好道別。"},{"s":5.68,"e":11.54,"t":"今天過得好不好都沒關係，明天太陽還是會升起來。"}]},{"id":"food","chip":"想吃你煮的菜","keys":["吃","煮","菜","飯","料理","做飯","餐","味道"],"caps":[{"s":0.0,"e":4.42,"t":"哈哈，我的手藝哪比得上你媽媽。"},{"s":4.67,"e":13.66,"t":"想吃的話，就一家人圍在桌邊好好吃一頓，就像以前一樣，我也就在那裡了。"}]},{"id":"festival","chip":"過年／中秋回家了","keys":["過年","新年","中秋","端午","清明","節日","團圓","掃墓","祭拜","生日"],"caps":[{"s":0.0,"e":5.28,"t":"回家了好，一家人團團圓圓的，我最開心了。"},{"s":5.53,"e":12.68,"t":"替我多夾點菜給你媽媽，大家熱熱鬧鬧的，不要冷冷清清。"}]},{"id":"fight","chip":"家裡有人吵架了","keys":["吵架","吵","不合","爭","誤會","生氣","兄弟","姊妹","不講話"],"caps":[{"s":0.0,"e":2.44,"t":"一家人哪有隔夜仇。"},{"s":2.69,"e":6.75,"t":"退一步，先開口的那個人最了不起。"},{"s":7.0,"e":12.49,"t":"看在爸爸的份上，坐下來好好說說話，好嗎？"}]},{"id":"forget","chip":"我怕會忘記你","keys":["忘記","忘了","記不得","記得我","記住"],"caps":[{"s":0.0,"e":1.93,"t":"忘了也沒關係。"},{"s":2.18,"e":7.89,"t":"我教你們的那些溫柔、耐心，都已經長在你們身上了。"},{"s":8.14,"e":11.78,"t":"你好好過日子，就是記得我。"}]},{"id":"hug","chip":"好想再抱抱你","keys":["抱","擁抱","抱抱","牽手","摸摸頭","再見一面","見你"],"caps":[{"s":0.0,"e":1.93,"t":"來，爸爸抱一下。"},{"s":2.18,"e":5.24,"t":"閉上眼睛，感覺到了嗎？"},{"s":5.49,"e":12.79,"t":"以後想抱我的時候，就去抱抱身邊的家人吧，那也是在抱我。"}]},{"id":"regret","chip":"你有什麼遺憾嗎？","keys":["遺憾","後悔的事","沒做到","心願","願望","還想做"],"caps":[{"s":0.0,"e":4.75,"t":"要說遺憾，就是陪你們的時間不夠多。"},{"s":5.0,"e":9.02,"t":"所以你們要替我，多陪陪彼此。"},{"s":9.27,"e":12.88,"t":"其他的，我這一生都很知足了。"}]},{"id":"pet","chip":"家裡的事都好","keys":["家裡","家人都好","大家都好","一切都好","放心","報平安","近況"],"caps":[{"s":0.0,"e":3.77,"t":"聽到大家都好，我就放心了。"},{"s":4.02,"e":8.95,"t":"日子平平安安的，就是最大的幸福。"}]},{"id":"who","chip":"你是誰？","keys":["你是誰","你是真的嗎","是AI嗎","機器人","真的是你嗎","假的"],"caps":[{"s":0.0,"e":5.78,"t":"我是家人用照片和回憶，替王大明做出來的影像。"},{"s":6.03,"e":11.39,"t":"話是大家一起寫的，聲音是電腦合成的。"},{"s":11.64,"e":14.68,"t":"但這些心意，都是真的。"}]},{"id":"hello","chip":"爸，我來看你了","keys":["來看你","你好","哈囉","嗨","我來了","早安","晚安","我是"],"caps":[{"s":0.0,"e":0.82,"t":"來啦？"},{"s":1.07,"e":2.34,"t":"好，好。"},{"s":2.59,"e":5.75,"t":"來，坐一下，陪我說說話。"},{"s":6.0,"e":8.15,"t":"最近過得怎麼樣？"}]},{"id":"bye","chip":"我該走了","keys":["走了","再見","拜拜","掰掰","下次","要回去","先離開"],"caps":[{"s":0.0,"e":2.46,"t":"去吧，路上小心。"},{"s":2.71,"e":7.0,"t":"不用常常掛念我，好好過你的日子。"},{"s":7.25,"e":10.77,"t":"想我了，隨時回來說說話。"}],"bow":true},{"id":"fallback1","keys":[],"fallback":true,"caps":[{"s":0.0,"e":3.95,"t":"孩子，你說的話，爸爸都聽到了。"},{"s":4.2,"e":9.08,"t":"不管什麼事，我都在這裡，一直陪著你。"}]},{"id":"fallback2","keys":[],"fallback":true,"caps":[{"s":0.0,"e":2.0,"t":"嗯，我知道了。"},{"s":2.25,"e":5.14,"t":"你的心意，我都收到了。"},{"s":5.39,"e":8.61,"t":"要好好照顧自己，好嗎？"}]},{"id":"fallback3","keys":[],"fallback":true,"caps":[{"s":0.0,"e":4.28,"t":"這件事啊，爸爸相信你會處理好的。"},{"s":4.53,"e":9.03,"t":"不管你做什麼決定，我都站在你這邊。"}]}]